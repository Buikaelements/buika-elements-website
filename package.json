    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^4.8.0",
    "sanity": "^5.22.0",
    "styled-components": "^6.1.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
