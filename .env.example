# ───────────────────────────────────────────────
# Buika Elements — environment variables (example)
# Copy to .env.local and fill in values. Never commit real secrets.
# ───────────────────────────────────────────────

# Sanity
# Find these in sanity.io → project → API settings.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only token for previewing drafts and signing asset URLs.
# Create a token with Viewer + limited asset-read permissions.
SANITY_READ_TOKEN=

# Studio route basePath (if embedding the Studio at /studio)
NEXT_PUBLIC_SANITY_STUDIO_BASE_PATH=/studio

# ─────────────── Leads / CRM (HubSpot) ───────────────
# Private App access token. Scopes needed: crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=
# Optional: list ID to enrol new leads into
HUBSPOT_LEAD_LIST_ID=

# ─────────────── Email (Resend) ───────────────
RESEND_API_KEY=
RESEND_FROM="Buika Elements <hello@buikaelements.com>"
RESEND_REPLY_TO=simon@buikaelements.com

# ─────────────── Analytics (Plausible) ───────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=buikaelements.com
# Optional: self-hosted / EU endpoint
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# ─────────────── Newsletter (Substack) ───────────────
# Substack doesn't have an official API; this is just the publication URL
# so the embed form can target it.
NEXT_PUBLIC_SUBSTACK_URL=https://buikaelements.substack.com

# ─────────────── Contact form receipt ───────────────
CONTACT_NOTIFICATION_TO=simon@buikaelements.com

# ─────────────── Content source ───────────────
# Choose where whitepapers are loaded from:
#   "mdx"   → src/content/whitepapers/ (Git-based MDX files, default)
#   "sanity" → Sanity CMS via GROQ queries
#   "mock"   → src/lib/mock-data.ts (offline fallback)
# Server-side only — no NEXT_PUBLIC_ prefix needed.
CONTENT_SOURCE=mdx
